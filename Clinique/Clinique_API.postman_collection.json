{
  "info": {
    "name": "Clinique API",
    "_postman_id": "clinique-api-collection",
    "description": "Collection complète de l'API REST de gestion de clinique",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000/api" },
    { "key": "admin_token", "value": "" },
    { "key": "receptionniste_token", "value": "" },
    { "key": "medecin_token", "value": "" },
